{
  "name": "@zipcoin/app",
  "version": "0.1.0",
  "private": true,
  "description": "Zipcoin wallet: deposit ZC, prove in the browser, post to the Book, leave Doorstep messages, withdraw",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
