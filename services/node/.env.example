# Which roles this instance runs: indexer, api, relayer, asp. One instance can run all four; split
# them by giving each instance a different ROLES value and only the key it needs.
# indexer,api needs no key. Add relayer with RELAYER_PRIVATE_KEY; add asp with POSTMAN_PRIVATE_KEY.
ROLES=indexer,api
PORT=8080
# PUBLIC_URL=https://node.example.org
ALLOWED_ORIGINS=*

RPC_URL=
CHAIN_ID=1
CONFIRMATIONS=3

# From protocol/deployments/1.json after `forge script script/Deploy.s.sol`
DEPLOYMENT_BLOCK=
ENTRYPOINT=
POOL=
ZC_TOKEN=0xA2f6441c4839A7fD4eF8536b971ceD04c48A1CEA
BOOK=
DOORSTEP=

# SQLite file. In a container, mount a volume and set DB_PATH to a path on it, e.g. /data/zipcoin.sqlite
DB_PATH=./data/zipcoin.sqlite

# Association set postman (role: asp). This key only posts roots; it cannot move funds.
POSTMAN_PRIVATE_KEY=
ASP_DELAY_SECONDS=30
ASP_INTERVAL_MS=60000
ASP_BLOCKLIST=
ASP_POLICY_VERSION=1
# SANCTIONS_ORACLE defaults to the Chainalysis oracle on mainnet; set to override or leave unset.
# PINATA_JWT=

# Relayer (role: relayer). This key only holds gas; it receives the relay fee in ZC.
RELAYER_PRIVATE_KEY=
RELAYER_FEE_BPS=100
RELAYER_MAX_GAS_GWEI=50
RELAYER_RATE_LIMIT_PER_MIN=20
# Smallest withdrawal this relayer will submit, in wei of ZC (0 = no minimum). Fees are a percentage,
# so very small spends cost more gas than they earn; e.g. 500 ZC = 500000000000000000000
RELAYER_MIN_WITHDRAW=0

LOG_LEVEL=info
