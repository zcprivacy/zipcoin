{
  "name": "@zipcoin/node",
  "version": "0.1.0",
  "private": true,
  "description": "Zipcoin off-chain node: indexer, association set postman and relayer for the ZC Privacy Pool",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:abi": "node scripts/gen-abi.mjs"
  },
  "dependencies": {
    "@zk-kit/lean-imt": "2.2.4",
    "better-sqlite3": "11.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "multiformats": "13.3.1",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.5",
    "viem": "2.22.14",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.19",
    "@types/snarkjs": "0.7.9",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
